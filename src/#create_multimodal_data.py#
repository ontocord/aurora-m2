      ).images)
    model_time = time.time() - time0
    items_processed = len(images)
    logger.warning(f"Image Gen time: {model_time} "+str(len(data_list)) + " " + str(len(images)))
  #torch.cuda.empty_cache()
  for data  in data_list:
    data['media_list'] = []
