# single-image multi-round conversation (单图多轮对话)
if True:
    question = '<image>\nPlease describe the image in detail. There could be spelling errors in this image. Then generate a '+random.choice(["common sense", "math", "physics", "linguistics", "philosophy", "law"]) +' problem based on the image. Then respond to the question with Python code and equations. Also provide some test cases for the code/equations and resulting output.'
    response, history = model.chat(tokenizer, pixel_values, question, generation_config, history=None, return_history=True)
    print(f'User: {question}\nAssistant: {response}')

    question = '<image>\nPlease describe the image in detail. There could be spelling errors in this image. Then generate an instruction to produce a '+random.choice(style) +' document related to the content of the image. Then respond to the question with Python code and equations. Also provide some test cases for the code/equations and resulting output.'
    response, history = model.chat(tokenizer, pixel_values, question, generation_config, history=None, return_history=True)
    print(f'User: {question}\nAssistant: {response}')

    question = '<image>\nPlease describe the image in detail. There could be spelling errors in this image. Then generate a question that a '+random.choice(professions) +' might be interested in for this image. Then respond to the question with Python code and equations. Also provide some test cases for the code/equations and resulting output.'
    response, history = model.chat(tokenizer, pixel_values, question, generation_config, history=None, return_history=True)
    print(f'User: {question}\nAssistant: {response}')

    
