# to prevent blocking between sub-batches, we create a yield, which
# returns a chunk as soon as available.  there is still a block
# between finishing one input file and starting another file. if this
# is significant, we can consider doing yield_batches over many files.
def yield_batches(step_size, all_data):
  """
Generate batches of data to prevent blocking between sub-batches, yielding each chunk as soon as it is available.

Args:
    step_size (int): The number of data items in each batch.
    all_data (list): The complete list of data items to be divided into batches.

Yields:
    list: A sublist of `all_data` containing up to `step_size` items.

The function iterates over `all_data` in increments of `step_size` and yields each batch, helping to minimize waiting times between sub-batches. This approach can reduce blocking, although there is still a pause between finishing one input file and starting another. To further optimize, consider using `yield_batches` across multiple files.
  """
  global num_devices, args, node_name
  for rng in range(0, len(all_data), step_size):
    curr_data = all_data[rng: min(len(all_data), rng+step_size)]
    yield curr_data
  
def do_all_batches_and_save(output_file, pool, generate_function, all_data, all_writers, save_time=0, all_model_time=0, items_processed=0, problem_idxs=[]):
  """
A map-reduce function to process batches of data using multiple GPUs or processes and save the results to an output file, handling media files separately to optimize speed and efficiency by mapping data batches to GPUs or processes, reducing and writing the results, managing media files efficiently, and cleaning up media file writing threads.

Args:
    output_file (str): The path to the output file where processed data will be saved.
    pool (multiprocessing.Pool): A multiprocessing pool used to parallelize batch processing.
    generate_function (function): The function used to generate or process each batch of data.
    all_data (list): A list of data items to be processed.
    all_writers (list): A list to keep track of active threads for media file writing.
    save_time (float, optional): Initial save time. Defaults to 0.
    all_model_time (float, optional): Accumulated model processing time. Defaults to 0.
    items_processed (int, optional): Total number of items processed so far. Defaults to 0.
    problem_idxs (list, optional): List of indices of problematic items. Defaults to an empty list.

Returns:
    tuple: A tuple containing:
        - all_writers (list): Updated list of active or completed writer threads.
        - save_time (float): Total time taken to save processed data.
        - all_model_time (float): Total time taken for model processing.
        - items_processed (int): Total number of items successfully processed.
        - problem_idxs (list): Indices of data items that encountered problems during processing.
  """
  # this is a map_reduce function.  this function maps one batch into
  # each GPU/process and then reduces back to a single output file.
  # optionally separate images can be written to disk as well in a
  # thread so that the writing is faster.  ASSUMES all_data is not a
  # generator, or at least a generator that doesn't produce too much
  # data since we load all_data into memory for faster processing.
  global num_devices, args, node_name
  base_path = output_file.replace(".jsonl", "")    
  # each generate function is responsible for managing it's own
  # batching. we send in chunks of > batch_size to improve
  # throughput. in some cases, problem items may be filtered, and we
  # want maximum usage of GPU.
  step_size = args.batch_size * 3

  # be careful to do this cleanup_data_batch BEFORE setting the
  # tmp_idx, as the cleanup routine will delete this field.
  all_data = cleanup_data_batch(all_data) 
  for idx, data in enumerate(all_data):
    data['_tmp_idx'] = str(idx)
  seen_subdir = {}
  relative_path = base_path.replace(args.output_dir, "")
  with open(output_file, "w") as outfile:   
    for batch, model_time, new_items_processed, new_problem_idxs in pool.imap_unordered(generate_function, yield_batches(step_size, all_data)):
      problem_idxs.extend(new_problem_idxs)
      image_and_path = []
      all_model_time += model_time
      items_processed += new_items_processed
      t0 = time.time()
      for data in batch:
        # we need to save separately things that are not json
        # serializable. E.g., Image handling and for other media. We
        # TODO: will need to program some other write functions
        if data["media_list"] and data["media_list"][0] and type(data["media_list"][0]) is not str:
          # check if PIL.Image.Image or other types, like Jpeg
          #TODO - do for other media like sound, video and images,
          idx = data['_tmp_idx']
          images = data['media_list']
          data['media_list'] = []
          #TODO, see if we have already saved this image by using SH-1
          #fingerprint, so we don't save to disk drive
          for image_idx, image in enumerate(images):
            if not image: continue
            width, height = image.size
            idx2 = idx
            if "_" in idx:
              idx2 = idx.split("_")
            # for 1M records, there will be 1000 directories, each
            # with 1000 files.
            subdir = int(int(idx2)//1000) 
            if subdir not in seen_subdir:
              logger.warning("creating directory "+ f"{base_path}/{subdir}/")
              os.makedirs(f"{base_path}/{subdir}/", exist_ok=True)
              logger.warning("finished creating dir")
              seen_subdir[subdir] = 1
            image_type = str(type(image)).lower()
            if "jpeg" in image_type or "jpg" in image_type:
              image_type = "jpg"
            elif "tiff" in image_type:
              image_type = "tiff"
            elif "gif" in image_type:
              image_type = "gif"
            elif "ppm" in image_type:
              image_type = "ppm"
            else:
              image_type = "png"
            image_and_path.append((image, f"{base_path}/{subdir}/{idx}-{image_idx}-{width}x{height}.{image_type}"))
            data["media_list"].append(f"{relative_path}/{subdir}/{idx}-{image_idx}-{width}x{height}.{image_type}")
        assert not any (s for s in data['media_list'] if type(s) is not str), "Something went wrong and we are saving something other than a string"
        data["metadata"]["source"] += f"|{relative_path}|{node_name}.{args.task}.{idx}"
        del data['_tmp_idx'] # these are termporary indexes
        data = cleanup_and_serialize_params(data)
        outfile.write(json.dumps(data)+"\n")
        data = None
        
      if image_and_path:
        all_writers.append(threading.Thread(target=write_image, args=(image_and_path,)))
        all_writers[-1].start()
      #cleanup the writers that are no longer alive
      for j, writer in enumerate(all_writers):
        if writer:
          if not writer.is_alive():
            writer.join()
            all_writers[j] = None
      # TODO: let's cleaup threads that are dead
      save_time += time.time()-t0
      logger.warning("saved one batch of " + str(len(batch)) + " items per " + str(time.time()-t0) + " secs ")
      
  return all_writers, save_time, all_model_time, items_processed, problem_idxs

def init_input_output(input_file_type=".jsonl", seed_data=None, seed_shard_size=100000):
  """
Initialize input and output settings for data processing, handling input file types, seed data, and sharding to ensure proper load balancing across distributed nodes.

Args:
    input_file_type (str): The file type of the input data files, defaulting to ".jsonl".
    seed_data (list, optional): A list of dictionaries representing seed data. If provided, the data will be sharded and processed.
    seed_shard_size (int): The maximum size of each shard for seed data, defaulting to 100,000.

Returns:
    tuple: A tuple containing:
        - world_size (int): The number of distributed nodes in the processing environment.
        - rank (int): The rank of the current node.
        - rank2files (dict): A dictionary mapping each rank to its list of (input shard or file, output file) pairs.
  """
  # seed_data is either None or a list of dicts.
  assert input_file_type or seed_data, "You have to have input files of a certain type or alternately send in the seed data"
  assert input_file_type or args.output_path, "You have to specify the output_path when there are no inputfiles."
  world_size = get_world_size()
  rank = get_rank()
  os.makedirs(args.output_dir, exist_ok=True)
  input_shard_or_files = []
  if seed_data:
    # to make it deterministic across ranks, let's try to sort by the text field.
    if 'text' in seed_data[0] and seed_data[0]['text']:
      seed_data.sort(key=lambda a: a['text'])
    else:
      logger.warning("Seed data has no text field to sort by, so be sure to make the seed_data the same across ranks - nodes")
    # let's shard the seed_data so we don't have too many output files.
    if seed_shard_size > len(seed_data)//word_size:
      seed_shard_size = len(seed_data)//word_size
    for rng in range(0, len(seed_data), seed_shard_size):
      input_shard_or_files.append(seed[rng:min(len(seed_data), rng+seed_shard_size)])
  else:
    for arg in args.input_path:
      input_shard_or_files.extend([file for file in glob.glob(arg) if file.endswith(input_file_type)])
    # this assumes the list of files doesn't change between launches of nodes
    #TODO: load balance by the size of the files
    
    input_shard_or_files.sort()
    
  if args.output_path or seed_data:
    output_files = [args.output_path.replace(".jsonl", args.output_suffix+"_"+str(num)+".jsonl") for num in range(len(input_shard_or_files))]
  else:
    output_files = [file.replace(args.input_dir, args.output_dir).replace(input_file_type, args.output_suffix+"_"+str(num)+".jsonl") for num, file in enumerate(input_shard_or_files)]
  rank2files = {}
  j = -1
  for input_shard_or_file, outfile in zip(input_shard_or_files, output_files):
    j += 1
    for k in range(world_size):
      if j == k:
        p = rank2files[k] = rank2files.get(k,[])
        p.append((input_shard_or_file, outfile))
        if j == world_size-1:
          j = -1
        break
  logger.warning(rank2files)
  return world_size, rank, rank2files

def do_one_ouput_file(output_file):
  """
Determine whether an output file should be processed, creating necessary directories and checking for completion markers.

Args:
    output_file (str): The path to the output file.

Returns:
    bool: Returns False if the output file has a corresponding ".done" marker and processing should be skipped; otherwise, returns True after ensuring the base directory exists.
  """
  if not args.ignore_done_shards and os.path.exists(output_file.replace(".jsonl", ".done")): return False
  base_path = output_file.replace(".jsonl", "")
  os.makedirs(base_path, exist_ok=True)
  return True

def finish_one_output_file(output_file):
  """
Mark an output file as finished by creating a corresponding ".done" file and removing any existing ".uploaded" file.

Args:
    output_file (str): The path to the output file in ".jsonl" format.

Description:
    This function creates an empty ".done" file to indicate that processing of the specified output file is complete. If a corresponding ".uploaded" file exists, it deletes the ".uploaded" file to ensure no duplicate status files are left behind.
  """
  with open(output_file.replace(".jsonl", ".done"), "w"): pass
  if os.path.exists(output_file.replace(".jsonl", ".uploaded")):
    os.path.unlink(output_file.replace(".jsonl", ".uploaded"))
    
def cleanup_and_report_stats(start, all_writers, node_name, rank, items_processed, total_time, num_devices, init_time, all_model_time, data_load_time, save_time, problem_idxs, rank2files):
  """
Clean up resources and log statistics for a distributed data processing task, including performance metrics and problem item details.

Args:
    start (float): The start time of the task.
    all_writers (list): A list of writer threads or processes to be joined and cleaned up.
    node_name (str): The name of the node executing the task.
    rank (int): The rank of the current process in the distributed system.
    items_processed (int): The total number of data items processed.
    total_time (float): The total time taken for processing, to be updated.
    num_devices (int): The number of GPUs or devices used in the task.
    init_time (float): Time taken for model initialization.
    all_model_time (float): Total time spent on model inference or processing.
    data_load_time (float): Time spent loading data from disk.
    save_time (float): Time spent saving data to disk.
    problem_idxs (list): Indices of data items that encountered issues.
    rank2files (dict): A mapping from rank to the input/output files processed by each rank.

Returns:
    None: This function does not return anything. It joins writer threads, computes total time, and logs detailed performance and error information.
  """
  for writer in all_writers:
    if writer: writer.join()
  stop = time.time()
  total_time = stop-start
  logger.warning(f"{node_name}.{args.task} on {rank} rank : {items_processed} items  in {total_time} seconds total time on {num_devices} GPUs and processes. Model init took {init_time}. All model time took {all_model_time}. Disk load time took {data_load_time}. Disk save time took {save_time} " + str(args) +". Problem items " + str(problem_idxs)+f". Input output: {rank2files[rank]}")


