def main_standard_format():
  """
Main function to process and transform data from JSONL files in a standard format, handling data distribution across multiple GPUs and CPUs, and saving results.

This function reads JSONL files with specific fields (e.g., text, chosen, rejected_list, media_list) and performs tasks defined in `tasks_configs`. It uses multiprocessing to parallelize tasks, initializes models and devices, processes batches of data, and saves the output.

Steps:
1. Initialize the input-output file mappings and set up multiprocessing.
2. Load and distribute data across available devices using a multiprocessing pool.
3. Process each file in batches using a specified generate function, saving results to output files.
4. Clean up resources and log detailed statistics, including processing times and any issues encountered.

Global Variables:
    - args: Arguments passed to the script, defining task configurations.
    - node_name: The name of the current processing node.

Returns:
    None: The function executes data processing and saves output, logging performance and any problem indices.
  """
  # this function reads jsonls in the format we expect. e.g., text, chosen, rejected_list, media_list, ... etc. see definition in utils.py
  global args, node_name
  task = args.task
  generate_function = tasks_configs[task]['generate_function']
  all_writers = []
  start = time.time()
  items_processed = 0
  all_model_time = 0
  save_time = 0
  problem_idxs = []
  data_load_time = 0
  world_size, rank, rank2files = init_input_output(input_file_type=".jsonl")
  multiprocessing.set_start_method('spawn', force=True)
  with  multiprocessing.Pool(processes=num_devices) as pool:
    init_time = initialize_gpus_and_models(pool, args)
    for input_file, output_file in rank2files[rank]:  
      if do_one_ouput_file(output_file):
        t0 = time.time()
        all_data = [json.loads(l) for l in open(input_file).read().split("\n") if l.strip()]
        data_load_time += time.time()-t0
        all_writers, save_time, all_model_time, items_processed, problem_idxs = do_all_batches_and_save(output_file=output_file, pool=pool, generate_function=generate_function, all_data=all_data, all_writers=all_writers, save_time=save_time, all_model_time=all_model_time, items_processed=items_processed, problem_idxs=problem_idxs)
        finish_one_output_file(output_file)
  cleanup_and_report_stats(start, all_writers, node_name, rank, items_processed, total_time, num_devices, init_time, all_model_time, data_load_time, save_time, problem_idxs, rank2files)


def main_commoncatalog():
  """
Main function to read and process data from a common catalog, apply a specified data generation function, and handle distributed processing using GPUs.

This function performs the following steps:
1. Initializes input and output file handling based on the distributed system setup.
2. Sets up multiprocessing with a specified number of devices and initializes models and GPUs.
3. Reads input files in the .parquet format, processes data into a standard format, and applies a generation function to each data item.
4. Loads images from the data and handles each batch, saving results to output files.
5. Cleans up resources and logs performance statistics.

Args:
    None: This function does not take any direct arguments but relies on global variables, including `args` and `node_name`, which are configured externally.

Returns:
    None: This function does not return anything but performs all operations, from data loading and processing to saving and logging, within the function scope.
  """
  # reads from commoncatalog, and processes into our standard format, with the generate_function applied to each data item
  global args, node_name
  task = args.task
  generate_function = tasks_configs[task]['generate_function']
  all_writers = []
  start = time.time()
  items_processed = 0
  all_model_time = 0
  save_time = 0
  problem_idxs = []
  data_load_time = 0
  world_size, rank, rank2files = init_input_output(input_file_type=".parquet")
  logger.warning(rank2files)
  multiprocessing.set_start_method('spawn', force=True)
  with  multiprocessing.Pool(processes=num_devices) as pool:
    init_time = initialize_gpus_and_models(pool, args)
    for input_file, output_file in rank2files[rank]:
      logger.warning(input_file + " " + output_file)
      if do_one_ouput_file(output_file):
        t0 = time.time()
        df = parquet.read_table(input_file)
        all_data = []
        for image, caption, blip_text, title, usertags, url in zip(df['jpg'], df['caption'], df['blip2_caption'], df['title'], df['usertags'], df['downloadurl']):
          all_data.append({'media_list': [image], 'text': '',\
                           'metadata': {'source': '', 'params': { 'title': title.as_py(), 'blip_text': blip_text.as_py(), 'orig_caption': caption.as_py(), 'usertags': usertags.as_py(), 'url': url.as_py()}}})
        df = None
        data_load_time += time.time() - t0
        for idx, data in enumerate(all_data):
            data['media_list'] = [Image.open(BytesIO(image.as_py()))  for image in data['media_list']]
