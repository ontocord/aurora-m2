# we measure the perplexity of text with respect to the perplexity of
# standard text from wikipedia. the score is based on how much worst
# or better the perplexity is to the reference wikipedia perplexity.
# the score ranges between 1 and -1, higher meaning better.
def get_quality_score_batch(batch):
  """
Calculate the quality score of a batch of texts using a reference model.

Args:
    batch (list or str): A list of text samples or a single text sample to evaluate.

Returns:
    list: A list of quality scores for each text in the batch.
  """

  ref_text = """Artificial intelligence (AI), in its broadest sense, is intelligence exhibited by machines, particularly computer systems. It is a field of research in computer science that develops and studies methods and software that enable machines to perceive their environment and use learning and intelligence to take actions that maximize their chances of achieving defined goals.[1] Such machines may be called AIs.

Some high-profile applications of AI include advanced web search engines (e.g., Google Search); recommendation systems (used by YouTube, Amazon, and Netflix); interacting via human speech (e.g., Google Assistant, Siri, and Alexa); autonomous vehicles (e.g., Waymo); generative and creative tools (e.g., ChatGPT, Apple Intelligence, and AI art); and superhuman play and analysis in strategy games (e.g., chess and Go). However, many AI applications are not perceived as AI: "A lot of cutting edge AI has filtered into general applications, often without being called AI because once something becomes useful enough and common enough it's not labeled AI anymore."[2][3]

The various subfields of AI research are centered around particular goals and the use of particular tools. The traditional goals of AI research include reasoning, knowledge representation, planning, learning, natural language processing, perception, and support for robotics.[a] General intelligence—the ability to complete any task performable by a human on an at least equal level—is among the field's long-term goals.[4] To reach these goals, AI researchers have adapted and integrated a wide range of techniques, including search and mathematical optimization, formal logic, artificial neural networks, and methods based on statistics, operations research, and economics.[b] AI also draws upon psychology, linguistics, philosophy, neuroscience, and other fields.[5]

Artificial intelligence was founded as an academic discipline in 1956,[6] and the field went through multiple cycles of optimism,[7][8] followed by periods of disappointment and loss of funding, known as AI winter.[9][10] Funding and interest vastly increased after 2012 when deep learning outperformed previous AI techniques.[11] This growth accelerated further after 2017 with the transformer architecture,[12] and by the early 2020s hundreds of billions of dollars were being invested in AI (known as the "AI boom"). The widespread use of AI in the 21st century exposed several unintended consequences and harms in the present and raised concerns about its risks and the long-term effects in the future, prompting discussions about regulatory policies to ensure the safety and benefits of the technology."""

  def get_ppl_batch(text, max_length=256):
    if type(text) is str:
      text = [text]
    ret = []
    nlls_hash = {}
    inputs = ref_tokenizer(text, max_length=max_length, truncation=True, padding=True, return_tensors="pt").to(quality_ref_model.device)
    inputs.labels = inputs.input_ids
    with torch.no_grad():
      outputs = quality_ref_model(**inputs)
      for target_ids, mask, logits in zip(inputs.input_ids, inputs.attention_mask, outputs.logits):
        target_ids[mask==0] = -100
        #we could probably batch this
        loss = torch.nn.functional.cross_entropy(logits, target_ids)
        ret.append(loss.item())
    return ret

  if quality_ref_model is None:
    if model_registry.get(args.quality_ref_model) is None:    
      logger.warning(f'CREATING {args.quality_ref_model} MODEL')
      model_registry[args.quality_ref_model] = quality_ref_model = AutoModelForCausalLM.from_pretrained(args.quality_ref_model, trust_remote_code=True, torch_dtype=torch.bfloat16, cache_dir=args.cache_dir, attn_implementation="flash_attention_2").train().to(device)
      tokenizer_registry[args.quality_ref_model] = quality_ref_tokenizer = AutoTokenizer.from_pretrained(args.quality_ref_model, trust_remote_code=True, cache_dir=args.cache_dir, padding_side='left')
    quality_ref_model = model_registry[args.quality_ref_model]
    quality_ref_tokenizer = tokenizer_registry[args.quality_ref_model]
  
  if not hasattr(quality_ref_model, 'wikipedia_ref_score'):
    quality_ref_model.wikipedia_ref_score = get_ppl_batch(quality_ref_model, quality_ref_tokenizer, ref_text)[0]
  if type(batch) is str:
    batch = [batch]
  # make the score so that larger is better.
  return [-1*(quality_ref_model.wikipedia_ref_score - ppl)/quality_ref_model.wikipedia_ref_score for ppl in get_ppl_batch(quality_ref_model, quality_ref_tokenizer, batch)]


def initialize_gpus_and_models(pool, args):
  """
Initialize the GPUs and load the models using multiprocessing.

Args:
    pool (multiprocessing.Pool): A multiprocessing pool to parallelize initialization.
    args (Namespace): Configuration settings and parameters.

Returns:
    float: The time taken to initialize the GPUs and models.
  """

  t0 = time.time()
  # initialize the GPU per process
  initializer_args = []
  for device_number in range(num_devices):
    arg2 = copy.deepcopy(args)
    arg2.device_number = device_number
    initializer_args.append(arg2)
  for arg2, gpu_device in zip(initializer_args, pool.map(initialize, initializer_args, chunksize=1)):
    assert f"cuda:{arg2.device_number}" == gpu_device, "Something went wrong with GPU assignment"
  init_time = time.time() - t0  
  logger.warning(f"Initializing gpus and models took {init_time} secs")
  return init_time

